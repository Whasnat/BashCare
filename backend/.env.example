# ── Server ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────
# Option 1: Individual connection params (for local PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bashacare
DB_USER=postgres
DB_PASSWORD=your_password_here

# Option 2: Full connection URL (for hosted DBs like Neon, Supabase, Render)
# If DATABASE_URL is set, it takes priority over the individual params above.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ── JWT ───────────────────────────────────────────────────────────────
# REQUIRED in production — server will refuse to start without it.
JWT_SECRET=change_this_to_a_random_64_char_string
JWT_EXPIRES_IN=7d

# ── NID Encryption ────────────────────────────────────────────────────
# REQUIRED in production — used to encrypt tenant National ID numbers.
# Must be exactly 32 bytes (characters).
# NID_ENCRYPTION_KEY=your_32_character_secret_key_here

# ── bKash (Sandbox) ──────────────────────────────────────────────────
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
# BKASH_WEBHOOK_SECRET=  # Required to accept bKash webhooks

# ── Nagad (Sandbox) ──────────────────────────────────────────────────
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox.mynagad.com:10080
# NAGAD_WEBHOOK_SECRET=  # Required to accept Nagad webhooks

# ── Rocket ───────────────────────────────────────────────────────────
# ROCKET_WEBHOOK_SECRET=  # Required to accept Rocket webhooks

# ── Frontend URL (CORS) ──────────────────────────────────────────────
# The URL of the frontend application. Used for CORS origin validation.
FRONTEND_URL=http://localhost:5173
